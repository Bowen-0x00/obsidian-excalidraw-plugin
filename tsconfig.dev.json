{
  "extends": "./tsconfig.json", //ymjr -- Share the pinned component type mappings.
  "compilerOptions": {
    "sourceMap": false,
    "module": "es2020",
    "target": "es2022", 
    "allowJs": false,
    "noImplicitAny": false, //ymjr -- Preserve the legacy development compiler setting.
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "lib": [
      "dom",
      "scripthost",
      "es2022",
      "DOM.Iterable"
    ],
    "jsx": "react",
    "inlineSourceMap": true,
    "baseUrl": "." //ymjr -- Resolve source aliases relative to this checkout.
  },
  "include": [
    "**/*.ts",
    "**/*.tsx", 
    "src/Dialogs/OpenDrawing.ts",
    "src/types/types.d.ts"
  ]
}