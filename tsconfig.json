{
  "compilerOptions": {
    "sourceMap": false,
    "module": "es2020",
    "target": "es2022", //min es2017 because script engine requires for async execution and min es2018 for named capture groups
    "allowJs": false,
    "noImplicitAny": true,
    "types": ["node"],
    "paths": {
      "src/*": ["./src/*"],
      //ymjr -- Use declarations from the same pinned fork that supplies runtime JS.
      "@zsviczian/excalidraw": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/excalidraw/index"],
      "@zsviczian/excalidraw/*": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/*"],
      "@excalidraw/common": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/common/src/index"],
      "@excalidraw/common/*": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/common/src/*"],
      "@excalidraw/element": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/element/src/index"],
      "@excalidraw/element/*": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/element/src/*"],
      "@excalidraw/math": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/math/src/index"],
      "@excalidraw/math/*": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/math/src/*"],
      "@excalidraw/utils": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/utils/src/index"],
      "@excalidraw/utils/*": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/utils/src/*"],
      "@excalidraw/excalidraw/*": ["../excalidraw-zsviczian-ymjr/packages/excalidraw/types/excalidraw/*"],
      //ymjr -- Keep a single React type identity across both source repositories.
      "react": ["./node_modules/@types/react/index"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "moduleResolution": "node",
    "esModuleInterop": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "lib": [
      "dom",
      "scripthost",
      "es2022",
      "DOM.Iterable"
    ],
    "jsx": "react",
  },
  "include": [
    "**/*.ts",
    "**/*.tsx", "src/shared/Dialogs/OpenDrawing.ts",
    "src/types/types.d.ts",
  ]
}